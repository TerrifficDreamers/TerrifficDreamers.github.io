---
const { member } = Astro.props;
const hasPhoto = member.image && member.image !== '/media/members/placeholder.png';
---
<div class="member" data-reveal="scale-in">
  <img
    class="member__avatar"
    src={hasPhoto ? member.image : '/media/logo/club-logo.svg'}
    alt={hasPhoto ? member.name : 'Clublogo als Platzhalter'}
    loading="lazy"
    onerror="this.onerror=null; this.src='/media/logo/club-logo.svg';"
  />
  <h3 class="member__name">{member.name}</h3>
  {member.age && <p class="member__age">{member.age} Jahre</p>}
  <div class="member__role">{member.role}</div>
  <p class="member__rank">{member.rank}{member.since ? ` · seit ${member.since}` : ''}</p>
  {member.quote && (
    <p class="member__quote">„{member.quote}“</p>
  )}
  {member.discord && (
    <p class="muted" style="font-size:0.85rem; margin-top:var(--sp-2);">@{member.discord}</p>
  )}
</div>
