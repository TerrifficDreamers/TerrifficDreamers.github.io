---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MemberCard from '../../components/MemberCard.astro';
import members from '../../config/members.json';
---
<BaseLayout title="Patenteam">
  <header class="page-header">
    <div class="container container--narrow">
      <span class="eyebrow">Management</span>
      <h1 data-letters>Patenteam</h1>
      <p class="muted">Unser Patenteam – Ansprechpartner, die neue Mitglieder begleiten und im Club willkommen heißen.</p>
    </div>
  </header>

  <section>
    <div class="container">
      {members.patenteam.length === 0 ? (
        <p class="muted" style="text-align:center;">Noch keine Einträge.</p>
      ) : (
        <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));" data-reveal-stagger>
          {members.patenteam.map((m) => <MemberCard member={m} />)}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
